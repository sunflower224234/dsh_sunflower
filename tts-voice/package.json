{
  "name": "dsh-tts-voice",
  "version": "0.2.0",
  "description": "DSH 语音朗读插件：宿主侧用本地 GPT-SoVITS 合成本地语音，客户端在「设置 → 语音」里提供原生配置页与可点击的悬浮开关",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "voice",
    "read-aloud",
    "gpt-sovits"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
