{
  "name": "dsh-im-readonly",
  "version": "0.1.0",
  "description": "DSH 插件：把 IM 群聊会话的权限预设固定为只读（read-only），让群里的机器人只能查询、不能改项目；单聊与其他渠道不受影响。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "im",
    "permission",
    "sandbox",
    "read-only"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
